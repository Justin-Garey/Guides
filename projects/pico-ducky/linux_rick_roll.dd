REM Rick Roll on Linux
ATTACKMODE HID STORAGE
DELAY 3000
CTRL ALT t
DELAY 2000
STRING curl -L -O https://github.com/Justin-Garey/Guides/raw/refs/heads/main/projects/pico-ducky/theme_song.zip
ENTER
STRING unzip -u theme_song.zip
ENTER
STRING rm theme_song.zip
ENTER
STRING (aplay theme_song.wav; rm theme_song.wav) &
ENTER
STRING exit
ENTER
